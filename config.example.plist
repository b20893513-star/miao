# Coordinate in *points* (non pixel retina).
# iPhone 11 Pro Max ≈ 414 × 896
#
# Copia su device (Filza):
#   /var/mobile/Library/Preferences/com.noxlab.miao.plist
#
# Poi: 3× Volume DOWN → tap
# oppure NewTerm: notifyutil -p com.noxlab.miao.tap

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>TapX</key>
	<real>80</real>
	<key>TapY</key>
	<real>160</real>
</dict>
</plist>
